<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>

    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>

    <!-- Native AOT: один самодостаточный бинарник, без рантайма .NET на целевой машине. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <!-- Прямой пиннинг: исправляет уязвимость транзитивного SQLitePCLRaw.lib.e_sqlite3 2.1.10. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\Static\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpDocs.Tests" />
  </ItemGroup>

</Project>
